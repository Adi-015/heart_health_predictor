# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
.env

# ML artifacts — ignore generated model files but track the deployment artifacts
*.joblib
*.h5
models/*.pkl
models/*.h5
# keep the three files Render needs to run the server
!models/model.pkl
!models/preprocessor.pkl

# Generated data & outputs
figures/
data/*.csv
data/*.zip

# In results/, ignore generated outputs but keep markdown tables and SHAP plots
results/*.csv
results/shap_*.png linguist-generated=false
# keep these explicitly tracked
!results/shap_summary.png
!results/shap_example_waterfall.png

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
